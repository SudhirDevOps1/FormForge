{
  "name": "formforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node build-cf.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:setup:local": "wrangler d1 migrations apply formforge-db --local",
    "db:migrate:local": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "setup": "node setup.js"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "drizzle-orm": "0.38.3",
    "next": "15.1.3",
    "nodemailer": "^7.0.13",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "drizzle-kit": "0.30.1",
    "postcss": "^8.4.0",
    "typescript": "5.7.2",
    "wrangler": "^4.108.0"
  },
  "description": "Privacy-first open-source form backend for static sites on Cloudflare Workers and D1",
  "cloudflare": {
    "env-variables": [
      "APP_NAME",
      "RESEND_FROM"
    ],
    "secrets": [
      "AUTH_SECRET",
      "RESEND_API_KEY"
    ],
    "bindings": {
      "AUTH_SECRET": {
        "description": "Secret for authentication system. Use https://jwtsecrets.com or openssl rand -hex 32 to generate a secure secret (64 characters). No need to remember it."
      },
      "RESEND_API_KEY": {
        "description": "Optional. API key from Resend.com to send transactional emails (verification links & submission alerts)."
      },
      "RESEND_FROM": {
        "description": "Optional. Verified sender address for email notifications (e.g. onboarding@resend.dev or your domain email)."
      }
    }
  }
}
