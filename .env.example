# ==============================================================================
# FormForge Environment Variables & Secrets Reference
# ==============================================================================
# Works 100% on FREE SUBDOMAINS:
#   - Vercel:      https://your-project.vercel.app
#   - Netlify:     https://your-site.netlify.app
#   - Cloudflare:  https://your-worker.workers.dev / https://your-site.pages.dev
# No custom domain, no credit card required!
# ==============================================================================

# ==============================================================================
# 🔴 [CRITICAL SECRETS] - SENSITIVE CREDENTIALS (NEVER COMMIT IN PUBLIC REPOS)
# In Vercel / Netlify / Cloudflare: Add these under "Environment Secrets" (Encrypted)
# ==============================================================================

# 1. Primary Authentication Secret (Required, 64 hex characters)
# Generate with: openssl rand -hex 32
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 2. Turso (libSQL) Database Auth Token (Required if using Turso DB)
# Obtained via: turso db tokens create formforge-db
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# 3. Neon Serverless Postgres Database URL (Optional: 0.5GB Free, Serverless, Zero Card)
# Obtained from Neon Console > Connection String
NEON_DATABASE_URL=postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Transactional Email Provider Keys (Optional, Pick One)
# Resend API Key (100 free emails/day)
RESEND_API_KEY=re_123456789_abcdef
# Brevo API Key (300 free emails/day)
BREVO_API_KEY=xkeysib-123456789abcdef
# SendGrid API Key (100 free emails/day)
SENDGRID_API_KEY=SG.123456789abcdef
# Mailgun API Key (5,000 free emails/month)
MAILGUN_API_KEY=key-123456789abcdef

# 4. Custom SMTP Password (Optional, use Gmail 16-character App Password or custom SMTP)
SMTP_PASS=abcd-efgh-ijkl-mnop

# 5. Backblaze B2 / S3 Secret Access Key (Optional for file uploads - 10GB FREE)
# Obtained from Backblaze B2 Console > App Keys
S3_SECRET_ACCESS_KEY=K004yourB2ApplicationKeyHere
B2_APPLICATION_KEY=K004yourB2ApplicationKeyHere

# 6. Telegram Bot Token (Optional, from @BotFather for 100% free unlimited push alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 7. Cloudflare Turnstile Secret Key (Optional for bot protection)
TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBBBBCCCCCCCCDDDDDDDD

# 8. Google Apps Script Secret Token (Optional, if SECRET_TOKEN is set in your GAS script)
GAS_SECRET=Blindshare_Super_Secret_Gas_Token_2026!_xyz


# ==============================================================================
# 🟢 [PLAIN TEXT / PUBLIC VARIABLES] - CONFIGURATION SETTINGS (SAFE AS PLAIN TEXT)
# In Vercel / Netlify / Cloudflare: Set as standard plain text variables
# ==============================================================================

# Application Branding
APP_NAME=FormForge
ALLOW_REGISTRATION=true

# Database Connection (Turso / libSQL) - 5GB Free, 100 DBs, No Card Needed
# Can also be: file:formforge.db for zero-config local development!
TURSO_DATABASE_URL=libsql://formforge-db-yourusername.turso.io

# Google Apps Script (GAS) Webhook URL (100% Free: 1,500 emails/day + Google Sheets logging)
# Deploy at script.google.com as Web App (Execute as Me, Access: Anyone)
GAS_URL=https://script.google.com/macros/s/AKfycbxExampleScriptIdHere/exec
GAS_SECRET=Blindshare_Super_Secret_Gas_Token_2026!_xyz

# Telegram Chat ID (Numeric ID from @userinfobot to receive push alerts)
TELEGRAM_CHAT_ID=987654321

# ntfy.sh Instant Mobile Push Topic (Zero-account required)
NTFY_TOPIC=my-formforge-alerts-7712

# Storage Configuration (Backblaze B2 - S3 Compatible, 10GB Free Storage)
# Endpoint format for B2: https://s3.<region>.backblazeb2.com
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_BUCKET_NAME=my-formforge-uploads
S3_ACCESS_KEY_ID=004yourB2KeyIdHere
S3_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=my-formforge-uploads
B2_APPLICATION_KEY_ID=004yourB2KeyIdHere

# Email Senders & Config
RESEND_FROM=forms@yourdomain.com
BREVO_FROM=forms@yourdomain.com
SENDGRID_FROM=forms@yourdomain.com
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=forms@mg.yourdomain.com

# Custom SMTP Settings (e.g. Gmail SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_FROM=yourname@gmail.com
