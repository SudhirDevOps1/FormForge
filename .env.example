# ==============================================================================
# FormForge Environment Variables & Secrets Reference
# ==============================================================================
# Works 100% on FREE TIER:
#   - Cloudflare Workers:  https://your-worker.workers.dev (Primary Native Platform)
#   - Vercel / Netlify:    https://your-app.vercel.app / .netlify.app
# Zero credit card required! Full guide: docs/CLOUDFLARE_SETUP_GUIDE.md
# ==============================================================================

# ==============================================================================
# 🌩️ [CLOUDFLARE WORKERS BINDINGS]
# Configured in Cloudflare Dashboard > Workers & Pages > Settings > Bindings
# OR automatically via: `npm run setup:kv` and `wrangler.jsonc`
# ==============================================================================
# 1. D1 Database Binding: Variable name `DB` -> bound to your D1 database
# 2. KV Namespace Binding: Variable name `CACHE` -> bound to your KV namespace


# ==============================================================================
# 🔴 [CRITICAL SECRETS] - ENCRYPTED CREDENTIALS (NEVER COMMIT IN PUBLIC REPOS)
# In Cloudflare: Settings > Variables and Secrets > Add > Secret (Encrypted)
# In Local Dev:  Stored in .env.local (Auto-generated by `npm run setup:env`)
# ==============================================================================

# 1. Primary Authentication Secret (Required, 64 hex characters)
# Generate with: openssl rand -hex 32 OR `npm run setup:env`
AUTH_SECRET=your_64_char_hex_auth_secret_here

# 2. Operator Emergency Account Recovery Token (Optional)
# Used to recover admin access via CLI: `npm run auth:recover`
RECOVERY_TOKEN=your_48_char_hex_recovery_token_here

# 3. Transactional Email Provider Keys (Optional, Pick One)
# Resend API Key (100 free emails/day) - https://resend.com
RESEND_API_KEY=your_resend_api_key_here
# Brevo API Key (300 free emails/day)
BREVO_API_KEY=your_brevo_api_key_here
# SendGrid API Key (100 free emails/day)
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Mailgun API Key (5,000 free emails/month)
MAILGUN_API_KEY=your_mailgun_api_key_here

# 4. Custom SMTP Password (Optional, e.g. Gmail 16-character App Password)
SMTP_PASS=your_smtp_password_here

# 5. Backblaze B2 / S3 Secret Access Key (Optional for file uploads - 10GB FREE)
# Obtained from Backblaze B2 Console > App Keys
S3_SECRET_ACCESS_KEY=your_b2_secret_key_here
B2_APPLICATION_KEY=your_b2_secret_key_here

# 6. Telegram Bot Token (Optional, from @BotFather for 100% free unlimited push alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 7. Google Apps Script Secret Token (Optional, if SECRET_TOKEN is set in your GAS script)
GAS_SECRET=your_gas_secret_token_here

# 8. External Database Credentials (Only if not using Cloudflare D1)
# Turso (libSQL):
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here
# Neon Serverless Postgres:
NEON_DATABASE_URL=postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require


# ==============================================================================
# 🟢 [PLAIN TEXT / PUBLIC VARIABLES] - CONFIGURATION SETTINGS (SAFE AS PLAIN TEXT)
# In Cloudflare: Settings > Variables and Secrets > Add > Environment Variable
# ==============================================================================

# Application Branding & Registration Gate
APP_NAME=FormForge
ALLOW_REGISTRATION=true

# Google Apps Script (GAS) Webhook URL (100% Free: 1,500 emails/day + Google Sheets logging)
GAS_URL=https://script.google.com/macros/s/AKfycbxExampleScriptIdHere/exec

# Telegram Chat ID (Numeric ID from @userinfobot to receive push alerts)
TELEGRAM_CHAT_ID=987654321

# ntfy.sh Instant Mobile Push Topic (Zero-account required)
NTFY_TOPIC=my-formforge-alerts-7712

# Storage Configuration (Backblaze B2 - S3 Compatible, 10GB Free Storage)
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_BUCKET_NAME=my-formforge-uploads
S3_ACCESS_KEY_ID=004yourB2KeyIdHere
S3_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=my-formforge-uploads
B2_APPLICATION_KEY_ID=004yourB2KeyIdHere

# Email Senders & Config
RESEND_FROM=forms@yourdomain.com
BREVO_FROM=forms@yourdomain.com
SENDGRID_FROM=forms@yourdomain.com
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=forms@mg.yourdomain.com

# Custom SMTP Settings (e.g. Gmail SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_FROM=yourname@gmail.com
