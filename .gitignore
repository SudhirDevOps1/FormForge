# dependencies
/node_modules
/.pnp
.pnp.js
# NOTE: package-lock.json IS tracked on purpose. CI runs `npm ci`, and
# actions/setup-node's npm cache needs a lockfile to hash. With the lockfile
# ignored, every workflow failed at the setup step and the quality gates
# never ran.

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# open-next & cloudflare workers
/.open-next/
/.wrangler/
/wrangler-local/
/dist/

# local env files
.env*.local
.env
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs and OS
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# github
# NOTE: `.github/` used to be ignored here, which silently disabled CI (the
# workflows were never pushed) and broke the repository's own security test
# suite, which asserts that `.github/workflows/{ci,security-scan,release}.yml`
# exist and enforce the quality gates. The workflows are tracked again.

# local development database
/formforge.db
/formforge.db-shm
/formforge.db-wal

# feature-test compilation scratch directory
/.tmp-feature-tests/
/.tmp-e2e.log
/.tmp-ci.log
/.tmp-featurestest/